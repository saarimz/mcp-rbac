 ],
 "conditions": {
  "refund_owner": {
   "name": "refund_owner",
   "expression": "amount >= 0.01 && amount <= 10000.0 && reason_len <= 500",
   "parameters": {
    "amount": {
     "type_name": "TYPE_NAME_DOUBLE"
    },
    "reason_len": {
     "type_name": "TYPE_NAME_INT"
    }
   }
  },
  "refund_pm": {
   "name": "refund_pm",
   "expression": "amount >= 0.01 && amount <= 500.0 && reason_len <= 500",
   "parameters": {
    "amount": {
     "type_name": "TYPE_NAME_DOUBLE"
    },
    "reason_len": {
     "type_name": "TYPE_NAME_INT"
    }
   }
  },
  "booth_pm": {
   "name": "booth_pm",
   "expression": "space_id.matches(\"^B-[0-9]{1,3}$\")",
   "parameters": {
    "space_id": {
     "type_name": "TYPE_NAME_STRING"
    }
   }
  },
  "booth_vendor": {
   "name": "booth_vendor",
   "expression": "space_id.matches(\"^B-[0-9]{1,3}$\") && tier in [\"standard\", \"corner\"]",
   "parameters": {
    "space_id": {
     "type_name": "TYPE_NAME_STRING"
    },
    "tier": {
     "type_name": "TYPE_NAME_STRING"
    }
   }
  },
  "event_limits": {
   "name": "event_limits",
   "expression": "capacity >= 1.0 && capacity <= 5000.0 && title_len <= 120",
   "parameters": {
    "capacity": {
     "type_name": "TYPE_NAME_DOUBLE"
    },
    "title_len": {
     "type_name": "TYPE_NAME_INT"
    }
   }
  },
  "booking_limits": {
   "name": "booking_limits",
   "expression": "party_size >= 1.0 && party_size <= 40.0",
   "parameters": {
    "party_size": {
     "type_name": "TYPE_NAME_DOUBLE"
    }
   }
  },
  "send_admin": {
   "name": "send_admin",
   "expression": "recipients >= 1.0",
   "parameters": {
    "recipients": {
     "type_name": "TYPE_NAME_DOUBLE"
    }
   }
  },
  "send_marketer": {
   "name": "send_marketer",
   "expression": "recipients >= 1.0 && recipients <= 50000.0",
   "parameters": {
    "recipients": {
     "type_name": "TYPE_NAME_DOUBLE"
    }
   }
  },
  "read_limits": {
   "name": "read_limits",
   "expression": "page_size >= 1.0 && page_size <= 100.0 && days >= 1.0 && days <= 365.0",
   "parameters": {
    "page_size": {
     "type_name": "TYPE_NAME_DOUBLE"
    },
    "days": {
     "type_name": "TYPE_NAME_DOUBLE"
    }
   }
  },
  "profile_limits": {
   "name": "profile_limits",
   "expression": "email == \"\" || (size(email) <= 254 && email.matches(\"^[^@]+@[^@]+[.][A-Za-z]{2,}$\"))",
   "parameters": {
    "email": {
     "type_name": "TYPE_NAME_STRING"
    }
   }
  },
  "build_limits": {
   "name": "build_limits",
   "expression": "name_len <= 100 && count >= 1.0 && count <= 1000.0 && channel in [\"email\", \"sms\", \"push\", \"\"] && status in [\"draft\", \"manual\", \"live\", \"\"] && html_len <= 200000",
   "parameters": {
    "name_len": {
     "type_name": "TYPE_NAME_INT"
    },
    "count": {
     "type_name": "TYPE_NAME_DOUBLE"
    },
    "channel": {
     "type_name": "TYPE_NAME_STRING"
    },
    "status": {
     "type_name": "TYPE_NAME_STRING"
    },
    "html_len": {
     "type_name": "TYPE_NAME_INT"
    }
   }
  },
  "export_limits": {
   "name": "export_limits",
   "expression": "format in [\"csv\", \"json\", \"\"]",
   "parameters": {
    "format": {
     "type_name": "TYPE_NAME_STRING"
    }
   }
  }
 }
}