[1.345, "o", "\r\n"]
[1.784, "o", "\u001b[2mpolicy (mcp-rbac.yaml):\u001b[0m\r\n\u001b[2m  version: 1\u001b[0m\r\n\u001b[2m  roles:\u001b[0m\r\n\u001b[2m    owner: {includes: [staff], tools: [refund]}\u001b[0m\r\n\u001b[2m    staff: {tools: [list_events, checkin]}\u001b[0m\r\n\u001b[2m  tools:\u001b[0m\r\n\u001b[2m    refund: {limits: {amount: {min: 0, max: 500}}}\u001b[0m\r\n\u001b[2m  approvals:\u001b[0m\r\n\u001b[2m    - {tool: refund, when: {amount: {min: 100}}}\u001b[0m\r\n"]
[1.784, "o", "\u001b[2m  limits:\u001b[0m\r\n\u001b[2m    - {tool: checkin, max: 3, per: minute}\u001b[0m\r\n\r\n"]
[1.789, "o", "\u001b[1mdana (staff)\u001b[0m sees: list_events, checkin\r\n"]
[1.793, "o", "  \u001b[32mALLOW   \u001b[0m checkin ticketId=t1            checked in t1\r\n"]
[1.794, "o", "  \u001b[31mDENY    \u001b[0m refund ticketId=t1 amount=20   user:no_matching_permission\u001b[2m  staff cannot refund\u001b[0m\r\n"]
[1.795, "o", "  \u001b[32mALLOW   \u001b[0m checkin ticketId=t2            checked in t2\r\n"]
[1.795, "o", "  \u001b[32mALLOW   \u001b[0m checkin ticketId=t3            checked in t3\r\n"]
[1.795, "o", "  \u001b[31mDENY    \u001b[0m checkin ticketId=t4            rate_limited:0\u001b[2m  4th check-in this minute\u001b[0m\r\n"]
[1.796, "o", "\u001b[1msam (owner)\u001b[0m sees: list_events, checkin, refund\r\n"]
[1.797, "o", "  \u001b[32mALLOW   \u001b[0m refund ticketId=t1 amount=20   refunded 20 on t1\r\n"]
[1.797, "o", "  \u001b[33mAPPROVAL\u001b[0m refund ticketId=t1 amount=250  a human must approve\u001b[2m  refunds >= 100 need approval\u001b[0m\r\n"]
[1.797, "o", "  \u001b[31mDENY    \u001b[0m refund ticketId=t1 amount=900  user:constraint:above_max:amount\u001b[2m  over the 500 limit\u001b[0m\r\n"]
[1.801, "o", "\r\n"]
[1.801, "o", "audit: 8 decisions, hash chain verified\r\n\u001b[2mfirst allow after 267 ms, first deny after 268 ms (from process start)\u001b[0m\r\n\r\nnext: your own server: mcp-rbac demo --save-policy mcp-rbac.yaml, then docs/quickstart.md\r\n      any server, no code: mcp-rbac proxy --preset read-only -- <server command>\r\n"]
[8.801, "o", "\u001b[2J\u001b[H"]
[8.801, "o", "\r\n\u001b[2m# 2. any server you didn't write, no code: put the proxy in front of it\u001b[0m\r\n"]
[8.801, "o", "\u001b[2m#    agent.ts is an MCP client whose server command is:\u001b[0m\r\n"]
[8.801, "o", "\u001b[2m#    npx mcp-rbac proxy --preset read-only -- npx -y @modelcontextprotocol/server-filesystem ~/notes\u001b[0m\r\n"]
[8.801, "o", "\u001b[1;36m$\u001b[0m "]
