{"version": 2, "width": 104, "height": 31, "timestamp": 1794782966, "title": "mcp-rbac 0.5: npx mcp-rbac demo + read-only proxy in front of the filesystem server", "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}}
[0.4, "o", "\u001b[2m# 1. one command: a guarded MCP server, an agent, and the audit chain\u001b[0m\r\n"]
[0.4, "o", "\u001b[1;36m$\u001b[0m "]
[0.435, "o", "n"]
[0.47, "o", "p"]
[0.505, "o", "x"]
[0.54, "o", " "]
[0.575, "o", "m"]
[0.61, "o", "c"]
[0.645, "o", "p"]
[0.68, "o", "-"]
[0.715, "o", "r"]
[0.75, "o", "b"]
[0.785, "o", "a"]
[0.82, "o", "c"]
