# Copy to .env (gitignored) or run: npx tsx src/setup-env.ts
# Never commit real passwords or API keys. setup-env.ts generates user
# passwords locally and will not print them.

# Better Auth
AUTH_PORT=8787
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:8787
AUTH_DB=./data/better-auth.sqlite

# Seeded test users (one per mcp-rbac role). Generated by setup-env.ts.
OWNER_EMAIL=owner@mcp-rbac.test
OWNER_PASSWORD=
MARKETER_EMAIL=marketer@mcp-rbac.test
MARKETER_PASSWORD=
SUPPORT_EMAIL=support@mcp-rbac.test
SUPPORT_PASSWORD=

# Guarded MCP front door
MCP_PORT=8790
AUDIT_DB=./data/audit.sqlite
OTEL_OUT_DIR=./out

# Optional: OTLP HTTP endpoint used by the existing mcp-rbac telemetry
# exporters (leave unset to write traces only to out/traces.jsonl).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Live Klaviyo (optional). Do not set until a key is supplied.
# Local official package (uvx klaviyo-mcp-server) reads PRIVATE_API_KEY.
# This harness also accepts KLAVIYO_PRIVATE_API_KEY and copies it across.
# KLAVIYO_PRIVATE_API_KEY=
# PRIVATE_API_KEY=

# Upstream mode: mock (default) | live
# KLAVIYO_UPSTREAM=mock
