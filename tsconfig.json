{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "declaration": true,
    "types": ["node"]
  },
  "include": ["src", "examples", "test", "bench"],
  "exclude": ["examples/itm-agents", "examples/klaviyo-e2e", "bench/competitors", "node_modules"]
}
